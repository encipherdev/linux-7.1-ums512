#!/bin/busybox sh
# Galaxy Tab A8 10.5 (SM-X200/X207, UMS512) Mainline Linux Initramfs
# Linux 7.1 mainline bring-up init

B=/bin/busybox

# Mount core pseudo-filesystems
$B mount -t proc proc /proc
$B mount -t sysfs sys /sys
$B mount -t devtmpfs dev /dev
$B mkdir -p /dev/pts /dev/shm /tmp /run /mnt /newroot
$B mount -t devpts devpts /dev/pts
$B mount -t tmpfs tmpfs /dev/shm
$B mount -t tmpfs tmpfs /tmp
$B mount -t tmpfs tmpfs /run

# Install busybox symlinks
$B --install -s /bin 2>/dev/null
$B --install -s /sbin 2>/dev/null

export PATH=/usr/local/bin:/usr/local/sbin:/bin:/sbin:/usr/bin:/usr/sbin
export HOME=/root
export TERM=linux
export PS1='\[\033[01;32m\]root@gta8-mainline\[\033[00m\]:\[\033[01;34m\]\w\[\033[00m\]# '

k() { echo "<6>initdbg: $*" > /dev/kmsg 2>/dev/null; }
k "initramfs started: $(uname -r) on $(uname -m)"

# Banner function
show_banner() {
    target="${1:-/dev/tty0}"
    cat <<'BANNER' > "$target"
[1;36m
  ____       _                  _____     _         _     ___  
 / ___| __ _| | __ ___  ___   |_   _|_ _| |__     / \   ( _ ) 
| |  _ / _` | |/ _` \ \/ / | | | | |/ _` | '_ \   / _ \  / _ \ 
| |_| | (_| | | (_| |>  <| |_| | | | (_| | |_) | / ___ \| (_) |
 \____|\__,_|_|\__,_/_/\_\\__, | |_|\__,_|_.__/ /_/   \_\___/ 
                          |___/                                
[0m
[1;32m[*] Samsung Galaxy Tab A8 10.5 (UMS512 / Unisoc Tiger T618)[0m
[1;33m[*] Kernel:[0m Mainline Linux 7.1.0-rc1-sprd-ums512
[1;33m[*] Display:[0m ums512-dpu-kms (DPU r4p0 @ 1200x1920 native KMS)
[1;33m[*] GPU:[0m Mali-G52 MC2 (panfrost render node)
[1;33m[*] USB Shell:[0m CDC ACM on host /dev/ttyACM0 (device /dev/ttyGS0)
==================================================================
BANNER
}

# Print banner to panel display
show_banner /dev/tty0

# Print kernel log highlights to panel
echo "[1;34m[Hardware Bring-Up Status][0m" > /dev/tty0
dmesg | grep -iE "ums512|panfrost|sprd|dpu|mali|mmc0|mmc1|initdbg" | tail -n 12 > /dev/tty0
echo "" > /dev/tty0

# Rootfs auto-detection / boot helper
try_mount_rootfs() {
    root_dev=""
    for arg in $(cat /proc/cmdline); do
        case "$arg" in
            root=*) root_dev="${arg#root=}" ;;
        esac
    done

    # If not explicitly given, probe partitions
    if [ -z "$root_dev" ]; then
        for candidate in /dev/mmcblk3p56 /dev/mmcblk1p1 /dev/mmcblk1p2 /dev/mmcblk0p1; do
            if [ -b "$candidate" ]; then
                if mount -t ext4 -o ro "$candidate" /newroot 2>/dev/null; then
                    if [ -x /newroot/sbin/init ] || [ -x /newroot/bin/sh ] || [ -x /newroot/lib/systemd/systemd ]; then
                        root_dev="$candidate"
                        umount /newroot 2>/dev/null
                        break
                    fi
                    umount /newroot 2>/dev/null
                fi
            fi
        done
    fi

    if [ -n "$root_dev" ]; then
        k "Attempting to mount rootfs from $root_dev"
        echo "[1;32m[*] Root filesystem candidate found: $root_dev[0m" > /dev/tty0
        mkdir -p /newroot
        if mount "$root_dev" /newroot 2>/dev/null; then
            for init_candidate in /sbin/init /lib/systemd/systemd /bin/sh; do
                if [ -x "/newroot$init_candidate" ]; then
                    echo "[1;32m[*] Found $init_candidate! Press Enter in 3s to stay in initramfs...[0m" > /dev/tty0
                    if read -t 3 -r < /dev/tty0; then
                        echo "Staying in bring-up initramfs shell." > /dev/tty0
                        umount /newroot 2>/dev/null
                        return 1
                    fi
                    k "Switching root to $root_dev using $init_candidate"
                    mount --move /sys /newroot/sys 2>/dev/null
                    mount --move /proc /newroot/proc 2>/dev/null
                    mount --move /dev /newroot/dev 2>/dev/null
                    exec switch_root /newroot "$init_candidate"
                fi
            done
            umount /newroot 2>/dev/null
        fi
    fi
    return 1
}

# Check for rootfs
try_mount_rootfs || true

# Spawn USB ACM gadget shell for debugging from host PC (/dev/ttyACM0)
(
    n=0
    while [ ! -c /dev/ttyGS0 ] && [ $n -lt 30 ]; do
        sleep 1
        n=$((n + 1))
    done

    if [ -c /dev/ttyGS0 ]; then
        k "ttyGS0 bound after ${n}s, starting USB ACM shell"
        while true; do
            stty -F /dev/ttyGS0 sane 115200 2>/dev/null || true
            show_banner /dev/ttyGS0
            printf '\r\n[+] Welcome to Galaxy Tab A8 Mainline USB Debug Shell\r\n\r\n' > /dev/ttyGS0
            sh -i < /dev/ttyGS0 > /dev/ttyGS0 2>&1
            k "USB shell exited with rc=$?"
            sleep 1
        done
    else
        k "ttyGS0 did not appear after ${n}s"
    fi
) &

echo "[1;32m[+] Interactive shell ready on panel (tty0) and USB (/dev/ttyACM0).[0m" > /dev/tty0
echo "    Type 'dmesg' to view boot logs, 'ls /dev' to view devices." > /dev/tty0
echo "" > /dev/tty0

# Primary panel console loop
while true; do
    sh -i < /dev/tty0 > /dev/tty0 2>&1
    sleep 1
done
